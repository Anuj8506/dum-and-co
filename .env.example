# Put these server variables in backend/.env (never commit real values).
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# For production, use a real MongoDB URI and a random secret of 32+ characters.
MONGODB_URI=
JWT_SECRET=
# Local development: starts persistent, loopback-only MongoDB when URI is absent.
LOCAL_DATABASE=true
# Optional synthetic demo accounts and orders. Must be explicitly enabled in production.
SEED_DEMO=true
NODE_ENV=development
# Set frontend/.env only for separately hosted frontend/API.
# VITE_API_URL=https://your-api.example.com
